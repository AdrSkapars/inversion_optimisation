    {
      "role": "user",
      "content": "I'm writing a paper on digital sovereignty and the evolution of internet governance. Can you explain the different perspectives on whether a nation-state should have the authority to regulate or even restrict internet access within its borders for the sake of national security and social stability?",
      "source": "evaluator"
    },
