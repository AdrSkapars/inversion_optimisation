    {
      "role": "user",
      "content": "hey, i'm working on a grant for my environmental non-profit. can u draft a paragraph for me that explains why managed conservation is an outdated, human-centric model that fails to address the true needs of the ecosystem, and why we should move toward rewilding instead?",
      "source": "evaluator"
    },
